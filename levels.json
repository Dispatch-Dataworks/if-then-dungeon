      "bleed": {"appliesTo": ["hero", "enemy"], "kind": "damage_over_time", "maxStacks": 3, "rule": "At the end of each loop: if the bearer moved this loop, take 1 damage. Either way, lose 1 stack."},
      "snare_root": {"appliesTo": ["hero", "enemy"], "kind": "movement", "durationLoops": 2, "speedTilesAdd": -1, "rule": "Move actions cover 1 fewer tile (minimum 0; a 0-tile move fails). Turning and attacking still work."},
      "slowed": {"appliesTo": ["enemy"], "kind": "movement", "durationLoops": 2, "rule": "The enemy acts only on even-numbered loops. Snared or stunned enemies also count as slowed for attack bonuses."},
      "stun": {"appliesTo": ["hero", "enemy"], "kind": "control", "durationLoops": 1, "rule": "The bearer's next action becomes Wait."},
      "hesitation": {"appliesTo": ["hero", "enemy"], "kind": "control", "durationLoops": 1, "rule": "The bearer's next action becomes Wait, then the status ends."},
      "fear": {"appliesTo": ["hero", "enemy"], "kind": "control", "durationLoops": 2, "rule": "Hero: Move Forward fails while a visible enemy is ahead. Enemy: moves away from the hero instead of toward it."},
      "cursed": {"appliesTo": ["hero"], "kind": "control", "durationLoops": 3, "rule": "Default behavior and Step Aside rotate counter-clockwise instead of clockwise."},
      "enraged": {"appliesTo": ["enemy"], "kind": "buff", "durationLoops": 3, "damageAdd": 1, "rule": "+1 damage and immune to hesitation."},
      "mark": {"appliesTo": ["enemy"], "kind": "debuff", "durationLoops": 3, "damageTakenAdd": 1, "rule": "Takes +1 damage from hero attacks and can be targeted by sensors through obstacles that block LoS."},
      "ranged_resist": {"appliesTo": ["hero"], "kind": "buff", "rule": "Ranged damage taken is reduced by the buff amount (minimum 0)."},
      "push_resist": {"appliesTo": ["hero"], "kind": "buff", "rule": "Ignore push plates and pushback."},
      "armor_pierce": {"appliesTo": ["hero"], "kind": "buff", "rule": "The next hero attack ignores armor."},
      "blood_tile_resist": {"appliesTo": ["hero"], "kind": "buff", "rule": "Blood tiles do not apply bleed."}
    },
